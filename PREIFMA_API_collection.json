{
  "info": {
    "name": "PREIFMA API",
    "description": "Collection completa da API REST do PREIFMA.\n\n**Como usar:**\n1. Importe esta collection no Postman\n2. Configure a variável `base_url` (padrão: http://localhost:8000/api)\n3. Execute **Auth / Login** — o token JWT é salvo automaticamente\n4. Todos os outros requests já usam `{{access_token}}` no cabeçalho Authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "question_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "exam_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "mission_id",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token',  json.access);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teste@preifma.com\",\n  \"password\": \"senha123\",\n  \"name\": \"Aluno Teste\",\n  \"username\": \"aluno_teste\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register",
                ""
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token',  json.access);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lauanderson38@gmail.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh",
                ""
              ]
            }
          }
        },
        {
          "name": "Me (Usuário Logado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "👤 Perfil & Stats",
      "item": [
        {
          "name": "Ver Stats (XP, Streak, Level)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/users/stats/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "users",
                "stats",
                ""
              ]
            }
          }
        },
        {
          "name": "Atualizar Perfil",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lau Anderson Atualizado\",\n  \"username\": \"lau_dev\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/users/profile/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "users",
                "profile",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📚 Provas & Questões",
      "item": [
        {
          "name": "Listar Provas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/exams/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "exams",
                ""
              ]
            }
          }
        },
        {
          "name": "Detalhe da Prova",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/exams/{{exam_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "exams",
                "{{exam_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "Questão Individual",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions",
                "{{question_id}}",
                ""
              ]
            }
          }
        },
        {
          "name": "🧠 Explicação por IA (Tutor)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}/explain/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions",
                "{{question_id}}",
                "explain",
                ""
              ]
            }
          }
        },
        {
          "name": "🔍 Listar Questões com Filtro",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/questions/?subject=matematica&exam_type=integrado",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions",
                ""
              ],
              "query": [
                {
                  "key": "subject",
                  "value": "matematica"
                },
                {
                  "key": "exam_type",
                  "value": "integrado"
                }
              ]
            }
          }
        },
        {
          "name": "🎲 Questões Aleatórias (Simulado)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/questions/random/?count=5&subject=portugues",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "questions",
                "random",
                ""
              ],
              "query": [
                {
                  "key": "count",
                  "value": "5"
                },
                {
                  "key": "subject",
                  "value": "portugues"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "⚡ Sessões de Estudo",
      "item": [
        {
          "name": "Iniciar Sessão",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('session_id', String(json.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"quick\",\n  \"question_ids\": [1, 2, 3]\n}"
            },
            "url": {
              "raw": "{{base_url}}/sessions/start/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "start",
                ""
              ]
            }
          }
        },
        {
          "name": "Registrar Resposta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": 1,\n  \"alternative_id\": 1,\n  \"response_time\": 30\n}"
            },
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/answers/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{session_id}}",
                "answers",
                ""
              ]
            }
          }
        },
        {
          "name": "Finalizar Sessão",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duration_seconds\": 120\n}"
            },
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/finish/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "{{session_id}}",
                "finish",
                ""
              ]
            }
          }
        },
        {
          "name": "Histórico de Sessões",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sessions/history/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions",
                "history",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📅 Missões Diárias",
      "item": [
        {
          "name": "Listar Missões",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/missions/daily/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "missions",
                "daily",
                ""
              ]
            }
          }
        },
        {
          "name": "Resgatar Recompensa",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/missions/{{mission_id}}/claim/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "missions",
                "{{mission_id}}",
                "claim",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Dashboard & Progresso",
      "item": [
        {
          "name": "Dashboard (Home)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/dashboard/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dashboard",
                ""
              ]
            }
          }
        },
        {
          "name": "Progresso por Matéria",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/progress/subjects/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "progress",
                "subjects",
                ""
              ]
            }
          }
        }
      ]
    }
  ]
}