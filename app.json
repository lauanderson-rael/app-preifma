{
  "expo": {
    "name": "Pré-IFMA",
    "slug": "app-preifma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-preifma.png",
    "splash": {
      "image": "./assets/images/logo-preifma.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0FDF4"
    },
    "scheme": "apppreifma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "router": {
      "root": "src"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-preifma.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4",
          "dark": {
            "backgroundColor": "#F0FDF4"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
