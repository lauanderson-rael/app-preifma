{
  "expo": {
    "name": "Pré-IFMA",
    "slug": "app-preifma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-preifma.png",
    "splash": {
      "image": "./assets/images/logo-preifma.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0FDF4"
    },
    "scheme": "apppreifma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0FDF4",
        "foregroundImage": "./assets/images/logo-preifma.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.lauandersonrael.apppreifma",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "router": {
      "root": "src"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-preifma.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#F0FDF4",
          "dark": {
            "backgroundColor": "#F0FDF4"
          }
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff35d848-de29-4fe8-9994-6169e12a5e1e"
      }
    },
    "owner": "lauanderson-rael"
  }
}